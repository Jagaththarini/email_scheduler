
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, "Segoe UI", Arial, sans-serif;
}

.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background:
    radial-gradient(circle at 15% 20%, #a78bfa, transparent 35%),
    radial-gradient(circle at 85% 80%, #60a5fa, transparent 35%),
    linear-gradient(135deg, #111827, #312e81 55%, #1e3a8a);
}

.login-card {
  width: 100%;
  max-width: 430px;
  padding: 42px 38px;
  border: 1px solid rgba(255,255,255,.45);
  border-radius: 24px;
  background: rgba(255,255,255,.97);
  box-shadow: 0 25px 70px rgba(0,0,0,.28);
  animation: appear .5s ease;
}

.login-logo {
  margin-bottom: 30px;
  color: #312e81;
  font-size: 27px;
  font-weight: 800;
  letter-spacing: -1px;
}

.login-logo span {
  color: #7c3aed;
}

h1 {
  margin: 0 0 10px;
  color: #111827;
  font-size: 30px;
}

.login-subtitle {
  margin: 0 0 30px;
  color: #6b7280;
  font-size: 14px;
  line-height: 1.6;
}

form {
  display: flex;
  flex-direction: column;
}

label {
  margin-bottom: 9px;
  color: #374151;
  font-size: 13px;
  font-weight: 650;
}

input {
  width: 100%;
  height: 48px;
  margin-bottom: 21px;
  padding: 0 14px;
  border: 1px solid #d1d5db;
  border-radius: 11px;
  outline: none;
  background: #fff;
  color: #111827;
  font-size: 14px;
}

input:focus {
  border-color: #7c3aed;
  box-shadow: 0 0 0 4px rgba(124,58,237,.12);
}

.password-wrap {
  position: relative;
}

.password-wrap input {
  padding-right: 65px;
}

.show-password {
  position: absolute;
  top: 0;
  right: 10px;
  height: 48px;
  border: 0;
  background: transparent;
  color: #7c3aed;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.show-password:hover {
  color: #5b21b6;
}

.login-error {
  margin: -7px 0 16px;
  padding: 11px 13px;
  border: 1px solid #fecaca;
  border-radius: 9px;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 13px;
}

.login-submit {
  width: 100%;
  height: 49px;
  margin-top: 2px;
  border: 0;
  border-radius: 11px;
  background: linear-gradient(110deg, #7c3aed, #4f46e5, #2563eb);
  color: white;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 8px 18px rgba(79,70,229,.25);
  transition: .2s;
}

.login-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(79,70,229,.35);
}

.demo-credentials {
  margin-top: 25px;
  padding: 15px 17px;
  border: 1px solid #ddd6fe;
  border-radius: 12px;
  background: #f5f3ff;
  color: #4b5563;
  font-size: 12px;
}

.demo-credentials strong {
  display: block;
  margin-bottom: 9px;
  color: #5b21b6;
}

.demo-credentials p {
  margin: 5px 0;
  line-height: 1.5;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 480px) {
  .login-page {
    padding: 16px;
  }

  .login-card {
    padding: 32px 23px;
    border-radius: 19px;
  }

  h1 {
    font-size: 26px;
  }
}